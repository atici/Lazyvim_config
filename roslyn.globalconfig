# ============================================================
# Roslyn Global Analyzer Configuration
#
# This file must be symlinked to your HOME directory as:
#   ~/.globalconfig   (Linux / macOS)
#   %USERPROFILE%\.globalconfig   (Windows)
#
# Roslyn (and roslyn.nvim) will automatically read it from there.
#
# --- Symlink commands ---
#
# Windows (PowerShell):
#   New-Item -ItemType SymbolicLink `
#     -Path $env:USERPROFILE\.globalconfig `
#     -Target $env:LOCALAPPDATA\nvim\roslyn.globalconfig
#   COMMMAND USED:
#   New-Item -ItemType SymbolicLink -Path $env:USERPROFILE\.globalconfig -Target C:\dev\nvim\roslyn.globalconfig
#
# Linux / macOS:
#   ln -s ~/.config/nvim/roslyn.globalconfig ~/.globalconfig
#
# After creating or updating this file:
#   Restart Neovim or run :LspRestart
# ============================================================
is_global = true

dotnet_diagnostic.IDE0044.severity = none
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0032.severity = none
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.IDE0060.severity = none
